{
    "name": "@wocker/jira-plugin",
    "type": "commonjs",
    "version": "1.0.0",
    "author": "Kris Papercut <krispcut@gmail.com>",
    "description": "Download Jira tasks and Confluence pages as markdown for wocker",
    "license": "MIT",
    "main": "./lib/index.js",
    "types": "./lib/index.d.ts",
    "keywords": [
        "wocker",
        "plugin"
    ],
    "scripts": {
        "prepublishOnly": "npm run build",
        "watch": "tsc -w --project tsconfig.build.json",
