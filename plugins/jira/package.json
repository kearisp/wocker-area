        "@wocker/helpers": "^1.0.0",
        "@wocker/prompts": "^1.0.0"
    },
    "devDependencies": {
        "@types/jest": "^30.0.0",
        "@types/node": "^24.13.3",
        "@wocker/testing": "^1.0.10",
        "jest": "^30.5.2",
        "ts-jest": "^29.4.14",
        "ts-node": "^10.9.2",
        "typescript": "^5.9.3"
    }
